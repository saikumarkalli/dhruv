<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.dhruv.finance.time.alarm.MathPuzzleActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <receiver
            android:name="com.dhruv.finance.time.service.alarm.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name="com.dhruv.finance.time.service.alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.dhruv.finance.time.service.alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
