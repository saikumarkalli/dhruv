<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Dhruv" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- Android 12+ SplashScreen API theme.
         Black background matches the Compose transition screen that follows, so there is no flash
         on launch. Uses the white crest variant from :libs:core for contrast on black (a crisp
         vector at the system-splash icon size; the detailed chrome logo appears on the Compose
         splash that follows).
         postSplashScreenTheme hands off to the existing NoActionBar theme once the splash exits. -->
    <style name="Theme.DhruvSplash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_dhruv_crest_white</item>
        <item name="postSplashScreenTheme">@style/Theme.Dhruv</item>
    </style>

</resources>
