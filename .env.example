# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# --- Platform-level identity (ADR-0031, "Dhruv ID") ---
# SUPABASE_URL / SUPABASE_ANON_KEY / GOOGLE_WEB_CLIENT_ID below are shared across every Dhruv app,
# not scoped to Finance, even though only :apps:finance:app reads them today (the only app that
# exists yet). One Supabase project ("dhruv") and one Google Cloud OAuth Web Client ID are the
# entire cross-app SSO mechanism — a future Tools/Health/Relationship app reads these exact same
# values from this exact same root .env (monorepo-wide, ADR-0001) and additionally registers its
# own Android OAuth client (package name + SHA-1) under the same Google Cloud project; it does not
# get its own SUPABASE_URL/GOOGLE_WEB_CLIENT_ID. Vault is explicitly excluded from this — see
# ADR-0031's decision 3 — and never reads any of these three keys.
#
# SUPABASE_URL: Base URL of the Supabase project backing the tracker (ADR-0014, ADR-0029).
# Placeholder, not a bare blank — a genuinely empty value here makes the `secrets` Gradle plugin
# emit an unquoted, non-compiling `public static final String SUPABASE_URL = ;` BuildConfig field
# (confirmed empirically against secrets-gradle-plugin 2.0.1 by decompiling its source; found
# during Task 3's review when the same class of bug was hit for GOOGLE_WEB_CLIENT_ID below, then
# verified this file's own SUPABASE_URL/SUPABASE_ANON_KEY defaults had the identical latent bug on
# a clean checkout with no local .env). Same GEMINI_API_KEY-style "obviously fake" placeholder
# convention as above — CI/dev must supply the real value via the secrets mechanism.
SUPABASE_URL=MY_SUPABASE_URL
# SUPABASE_ANON_KEY: Publishable anon key for the Supabase project (safe under RLS, ADR-0014 §6).
# Same placeholder-not-blank reasoning as SUPABASE_URL above.
SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY

# GOOGLE_WEB_CLIENT_ID: OAuth 2.0 Web client ID backing Google Sign-In via Credential Manager
# (A2 sign-in screen, ADR-0014 §6/§3 — Google-only sign-in; ADR-0031 — this ID is the cross-app SSO
# anchor, reused verbatim by every future Dhruv app, never per-app). This is the Web client, not the
# Android client, per Credential Manager's GetGoogleIdOption contract — each app registers its own
# Android OAuth client (package + SHA-1) under the same Google Cloud project, but this Web client ID
# stays identical everywhere.
# Placeholder, not a bare blank like SUPABASE_URL/SUPABASE_ANON_KEY above — confirmed empirically
# (decompiled secrets-gradle-plugin 2.0.1's ExtensionsKt.inject/addParenthesisIfNeeded) that a
# genuinely empty property value is emitted as an unquoted, non-compiling
# `public static final String GOOGLE_WEB_CLIENT_ID = ;`, whereas any non-empty value (including
# this placeholder) is correctly quoted. Same GEMINI_API_KEY-style "obviously fake" placeholder
# convention (line 5 above) — CI/dev must supply the real value via the secrets mechanism.
GOOGLE_WEB_CLIENT_ID=MY_GOOGLE_WEB_CLIENT_ID
