#!/bin/sh
# Pre-push gate. Two checks, in order:
#   1. Protected-branch block — no direct pushes to main/develop; everything via PR.
#   2. Compliance audit on feature modules — deterministic, zero AI tokens.
#
# Versioned, shared hook. Activate once per clone with:
#     git config core.hooksPath scripts/hooks
# (see scripts/hooks/README.md). Audits every feature module changed vs
# origin/develop against the project's hard rules.

# ---------------------------------------------------------------------------
# Check 0: protected branches (AGENTS.md branch rules, ADR-0032 decision 1)
#
# `develop` is DEV and `main` is PROD; both may only advance through a merged
# PR. GitHub's own branch protection / rulesets would enforce this server-side,
# but both are Pro-gated on a private repo and this repo is on GitHub Free
# (403 "Upgrade to GitHub Pro"; see ADR-0032's 2026-08-16 correction). Until
# that upgrade this hook is the *preventive* layer and
# .github/workflows/branch-guard.yml is the *detective* one — the hook stops
# the push, the workflow catches anything that bypassed the hook.
#
# Deliberate escape hatch for the genuine emergency:
#     DHRUV_ALLOW_PROTECTED_PUSH=1 git push ...
# (plain `--no-verify` also skips it, and skips the module audit below too).
# Either way branch-guard.yml still reports the violation on the push.
# ---------------------------------------------------------------------------

if [ "$DHRUV_ALLOW_PROTECTED_PUSH" != "1" ]; then
  BLOCKED=""
  # git feeds pre-push one line per ref on stdin:
  #   <local ref> <local sha> <remote ref> <remote sha>
  while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
      refs/heads/main|refs/heads/develop)
        case "$local_sha" in
          0000000000000000000000000000000000000000)
            BLOCKED="$BLOCKED\n  x DELETE ${remote_ref#refs/heads/}" ;;
          *)
            BLOCKED="$BLOCKED\n  x push to ${remote_ref#refs/heads/}" ;;
        esac
        ;;
    esac
  done

  if [ -n "$BLOCKED" ]; then
    echo ""
    echo "PUSH BLOCKED - main and develop are PR-only."
    printf "%b\n" "$BLOCKED"
    echo ""
    echo "  develop = DEV, main = PROD (ADR-0032). Both advance only via a merged PR."
    echo ""
    echo "  Move your work to a branch and open a PR:"
    echo "      git switch -c feat/<short-description>"
    echo "      git push -u origin feat/<short-description>"
    echo "      gh pr create --base develop --fill"
    echo ""
    echo "  Branch prefixes: feat/  fix/  chore/  refactor/  docs/"
    echo "  Emergency override: DHRUV_ALLOW_PROTECTED_PUSH=1 git push ..."
    echo "  (branch-guard.yml still flags the violation server-side.)"
    echo ""
    exit 1
  fi
fi
#
# Path pattern requires apps/<app>/feature/<bucket>/<name>/... (5+ segments) — corrected
# 2026-08-15 for the module-reorg bucket layout: every module now lives at
# apps/<app>/feature/<bucket>/<name>/, e.g. plan/loans, shell/currency. The old
# apps/<app>/feature/<name>/... (4-segment) pattern used the BUCKET folder name (plan,
# shell, home, calc, ...) as the "module name", which is not a real module and predictably
# failed every check for it. This pattern also naturally excludes bare files directly under
# feature/ or feature/<bucket>/ (e.g. README.md), which the old pattern mistook for modules too.

CHANGED=$(git diff --name-only origin/develop...HEAD 2>/dev/null \
  | grep -E '^apps/[^/]+/feature/[^/]+/[^/]+/' \
  | sed -E 's|^(apps/[^/]+/feature/[^/]+/[^/]+)/.*|\1|' \
  | sort -u)

if [ -z "$CHANGED" ]; then
  exit 0
fi

echo "Dhruv: checking feature modules before push..."

PASS=0
FAIL=0

# Modules with a documented, intentional no-feature-flag design (not an oversight to keep
# re-flagging on every push) — onboarding itself isn't feature-flagged (it gates everything else).
is_flag_exempt() {
  case "$1" in
    onboarding) return 0 ;;
    *) return 1 ;;
  esac
}

for MODULE in $CHANGED; do
  # Skip paths that aren't a real Gradle module: a pure deletion (old-layout file removed
  # during the bucket-layout move, directory no longer exists) or a doc-only scaffold folder
  # (README.md staged ahead of the module itself — CLAUDE.md's "not yet created" list; no
  # build.gradle.kts, not in settings.gradle.kts). Neither should be held to module rules.
  if [ ! -f "$MODULE/build.gradle.kts" ]; then
    continue
  fi

  APP=$(echo "$MODULE" | cut -d/ -f2)
  MOD_NAME=$(echo "$MODULE" | cut -d/ -f5)
  ISSUES=""

  # Check 1: FeatureHost wrapping.
  # Routes are wrapped in FeatureHost at the app/hub layer (e.g. FeatureHubs.kt /
  # MainActivity), not inside the feature module itself — so accept either the module
  # using FeatureHost directly, or the app shell wrapping this module's route as
  # FeatureHost("<module>", ...).
  if ! grep -rq "FeatureHost" "$MODULE/" 2>/dev/null && \
     ! grep -rq "FeatureHost(\"$MOD_NAME\"" "apps/$APP/app/" 2>/dev/null; then
    ISSUES="$ISSUES\n  ❌ Missing FeatureHost wrapping for '$MOD_NAME' (module or apps/$APP/app)"
  fi

  # Check 2: Feature flag entry (flag files are named dhruv-<app>.json in this repo)
  FLAG_FILE="platform/feature-flags/dhruv-$APP.json"
  if ! is_flag_exempt "$MOD_NAME" && { [ ! -f "$FLAG_FILE" ] || ! grep -q "\"$MOD_NAME\"" "$FLAG_FILE" 2>/dev/null; }; then
    ISSUES="$ISSUES\n  ❌ Missing feature flag entry for '$MOD_NAME' in $FLAG_FILE"
  fi

  # Check 3: Koin module declaration.
  # Was a single grep requiring val/Module/=/module all on one line — this repo's ktlint config
  # forces `val fooModule =` and `module {` onto separate lines
  # (standard:multiline-expression-wrapping), which a single-line grep can never match. Every
  # existing module (calculator, onboarding, loans, ...) already uses this exact wrapped style, so
  # the old check was silently vacuous for all of them; split into two independent single-line
  # checks that together tolerate either layout.
  if ! grep -rq "fun.*[Mm]odule\(\)" "$MODULE/" 2>/dev/null && \
     ! { grep -rq "val.*[Mm]odule" "$MODULE/" 2>/dev/null && grep -rq "module {" "$MODULE/" 2>/dev/null; }; then
    ISSUES="$ISSUES\n  ❌ No Koin module declared in $MODULE"
  fi

  # Check 4: No hardcoded API keys or secrets
  SECRETS=$(grep -rE "(api_key|apiKey|API_KEY|sk-ant-|AIza)['\"]?\s*[:=]\s*['\"][A-Za-z0-9_\-]{10,}" \
    "$MODULE/" 2>/dev/null | grep -v "BuildConfig\|secrets\|//" || true)
  if [ -n "$SECRETS" ]; then
    ISSUES="$ISSUES\n  ❌ Possible hardcoded secret in $MODULE"
  fi

  if [ -z "$ISSUES" ]; then
    echo "  ✅ $MODULE"
    PASS=$((PASS + 1))
  else
    echo "  ❌ $MODULE"
    printf "%b\n" "$ISSUES"
    FAIL=$((FAIL + 1))
  fi
done

echo ""
if [ "$FAIL" -eq 0 ]; then
  echo "AUDIT PASSED — $PASS module(s) checked. Push proceeding."
  exit 0
else
  echo "AUDIT FAILED — $FAIL violation(s) found. Fix them before pushing."
  echo "Tip: run /audit for a detailed AI-powered review."
  exit 1
fi
